# ==============================================================================
# PulseDesk AI — Customer Support Deflector SaaS (Root Environment)
# ==============================================================================

# PostgreSQL + pgvector
POSTGRES_DB=pulsedesk
POSTGRES_USER=pulsedesk
POSTGRES_PASSWORD=secret

# Default LLM Router Settings (Supports: openrouter | opencode | claude | openai | mock)
# Note: Each tenant can also configure their own provider & API key (BYOK) in the Vue Dashboard!
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

OPENROUTER_API_KEY=
OPENCODE_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=
DEFAULT_TENANT_SLUG=demo-store

# Internal Microservice Auth Secret (Laravel <-> Node.js TG Bot)
INTERNAL_WEBHOOK_SECRET=pulsedesk_internal_secret_key

# Stripe Billing Settings
STRIPE_KEY=pk_test_placeholder
STRIPE_SECRET=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
